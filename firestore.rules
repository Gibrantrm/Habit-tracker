rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasOptionalValidColor(data) {
      return !data.keys().hasAny(['color'])
        || (data.color is string && data.color.size() >= 1 && data.color.size() <= 30);
    }

    // Habit Validation Helper
    function isValidHabit(data) {
      return data.keys().hasAll(['name', 'completedDates', 'createdAt']) 
        && data.keys().hasOnly(['name', 'completedDates', 'createdAt', 'color'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.completedDates is list && data.completedDates.size() <= 1000
        && data.createdAt is number
        && hasOptionalValidColor(data);
    }

    match /users/{userId} {
      allow get, write: if isOwner(userId);
      
      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(habitId)
          && isValidHabit(incoming());

        allow update: if isOwner(userId)
          && isValidHabit(incoming())
          && incoming().createdAt == existing().createdAt // Immutable field
          && (
            // Action: Toggle completion or Rename
            incoming().diff(existing()).affectedKeys().hasOnly(['completedDates', 'name', 'color'])
          );

        allow delete: if isOwner(userId);
      }
    }
  }
}
